FROM docker.io/library/node:22-alpine AS build

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN corepack enable && pnpm install --frozen-lockfile

ARG VITE_REMOTE_BASE=/remotes/admin/
ENV VITE_REMOTE_BASE=$VITE_REMOTE_BASE

RUN pnpm --filter @niar/admin-web build

FROM docker.io/library/nginx:1.27-alpine

COPY apps/admin-web/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/admin-web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
