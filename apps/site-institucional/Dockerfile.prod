FROM docker.io/library/node:22-alpine AS build

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN corepack enable && pnpm install --frozen-lockfile

# URL do rag-api vista pelo navegador. Em produção é a mesma origem, e o Caddy
# repassa /api/rag/* ao container rag-api. Sem ela o /leme fica "em breve".
ARG PUBLIC_RAG_API_URL=/api/rag
ENV PUBLIC_RAG_API_URL=$PUBLIC_RAG_API_URL

RUN pnpm --filter @niar/site-institucional build

FROM docker.io/library/nginx:1.27-alpine

COPY apps/site-institucional/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/site-institucional/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
