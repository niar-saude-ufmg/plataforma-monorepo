# Production: static build served by nginx
FROM docker.io/library/node:22-alpine AS build

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN corepack enable && pnpm install --frozen-lockfile

ARG VITE_API_URL=/api/assistente
ARG VITE_REMOTE_BASE=/remotes/assistente/
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REMOTE_BASE=$VITE_REMOTE_BASE

RUN pnpm --filter @niar/assistente-web build

FROM docker.io/library/nginx:1.27-alpine

COPY apps/assistente-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/assistente-web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
