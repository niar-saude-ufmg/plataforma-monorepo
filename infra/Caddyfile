niarplataforma.duckdns.org {
	handle_path /remotes/admin/* {
		reverse_proxy admin-web:80
	}

	handle_path /remotes/assistente/* {
		reverse_proxy assistente-web:80
	}

	handle /api/assistente/* {
		reverse_proxy assistente-api:8000
	}

	handle /api/admin/* {
		reverse_proxy admin-api:3333
	}

	handle /api/rag/* {
		reverse_proxy rag-api:8001
	}

	# Rotas e assets da shell (APP_ROUTES em packages/config + build do Vite).
	# Ao criar uma rota nova na shell, inclua-a aqui.
	@shell path /login /login/* /cadastro/*/admin /admin/* /assistente /assistente/* /identidade-visual /identidade-visual/* /design-system /design-system/* /storybook /storybook/* /assets/*
	handle @shell {
		reverse_proxy shell:80
	}

	# Todo o resto é o site institucional (/, /en/, /about/, /news/..., /sala-segura/,
	# /_app/, /sitemap.xml). A página da Sala Segura é do site; o cadastro que ela chama
	# (/cadastro/pesquisador) continua na shell, pelo remote do admin-web.
	handle {
		reverse_proxy site-institucional-web:80
	}
}
