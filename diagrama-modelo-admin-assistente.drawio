        <mxCell id="project_documents" value="PROJECT_DOCUMENTS&#xa;---&#xa;id (PK)&#xa;project_id (FK → projects.id)&#xa;source_export_artifact_id (FK → export_artifacts.id, opcional)&#xa;document_type&#xa;original_filename&#xa;storage_path&#xa;is_current&#xa;created_at&#xa;&#xa;Uso principal: docx oficial visivel ao pesquisador e ao admin&#xa;Quando vier do assistente, aponta para o export_artifact do tipo project_docx" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
