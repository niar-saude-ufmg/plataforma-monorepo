        <mxCell id="title" value="Modelo proposto — Admin + Assistente (submissao governada pelo admin)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="Direção: nenhuma tabela existente do assistente sera alterada neste primeiro corte. A plataforma adiciona tabelas novas e referencia wizard_sessions/export_artifacts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
