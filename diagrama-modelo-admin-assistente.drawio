        </mxCell>
        <mxCell id="datasets_note" value="Observação de fluxo&#xa;---&#xa;Quando o assistente passar a estruturar data_source_type a partir de data_sources, será possível distinguir com mais clareza projetos com dataset próprio e projetos que exigem base do NIAR / sala segura." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="900" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="doc_note" value="Decisão atual&#xa;---&#xa;Criar project_documents para dar visibilidade ao documento principal do projeto.&#xa;Quando o docx vier do assistente, ele pode referenciar export_artifacts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="project_creation_note" value="Fluxo atual pensado&#xa;---&#xa;O pesquisador trabalha no assistente usando wizard_sessions.&#xa;No submit, nasce projects; o docx atual vira project_document; o status passa a ser governado pelo admin." style="shape=callout;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
