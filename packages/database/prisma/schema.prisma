generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["admin", "assistant", "shared"]
}

model User {
  id                Int                     @id @default(autoincrement())
  email             String                  @unique @db.VarChar(255)
  fullName          String                  @map("full_name") @db.VarChar(255)
  hashedPassword    String                  @map("hashed_password") @db.VarChar(255)
  role              user_role               @default(researcher)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  accountStatus     user_account_status     @default(active) @map("account_status")
  committeeProfile  CommitteeMemberProfile?
  projects          Project[]               @relation("ProjectOwner")
  researcherProfile ResearcherProfile?
  coepData          UserCoepData[]
  wizardSessions    WizardSession[]
  auditLogs         AuditLog[]
  statusChanges     ProjectStatusHistory[]  @relation("StatusActor")
  evaluationsMade   UserAuthEvaluation[]    @relation("AuthEvaluationEvaluator")
  authEvaluations   UserAuthEvaluation[]    @relation("AuthEvaluationUser")
  profile           UserProfile?

  @@index([email], map: "idx_shared_users_email")
  @@map("users")
  @@schema("shared")
}

model UserProfile {
  userId             Int      @id @map("user_id")
  phone              String?  @db.VarChar(50)
  institution        String?  @db.VarChar(255)
  organizationalUnit String?  @map("organizational_unit") @db.VarChar(255)
  contactAddress     String?  @map("contact_address")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
  @@schema("shared")
}

model UserAuthEvaluation {
  id                Int                 @id @default(autoincrement())
  userId            Int                 @map("user_id")
  status            user_account_status
  justification     String?
  evaluatedByUserId Int?                @map("evaluated_by_user_id")
  evaluatedAt       DateTime?           @map("evaluated_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  userCoepDataId    Int?                @map("user_coep_data_id")
  coepData          UserCoepData?       @relation(fields: [userCoepDataId], references: [id], onUpdate: NoAction, map: "fk_shared_user_auth_evaluations_coep")
  evaluatedBy       User?               @relation("AuthEvaluationEvaluator", fields: [evaluatedByUserId], references: [id], onUpdate: NoAction)
  user              User                @relation("AuthEvaluationUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_shared_user_auth_evaluations_user_id")
  @@map("user_auth_evaluations")
  @@schema("shared")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
  @@schema("shared")
}

model Dataset {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(255)
  description String          @default("")
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions    WizardSession[]
  tables      CatalogTable[]

  @@map("datasets")
  @@schema("shared")
}

model CatalogTable {
  id                Int                 @id @default(autoincrement())
  datasetId         Int                 @map("dataset_id")
  name              String              @db.VarChar(255)
  description       String              @default("")
  sampleRows        String              @default("[]") @map("sample_rows")
  columns           CatalogColumn[]
  dataset           Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  relationshipsFrom TableRelationship[] @relation("FromTable")
  relationshipsTo   TableRelationship[] @relation("ToTable")

  @@unique([datasetId, name], map: "uq_shared_table_dataset_name")
  @@map("catalog_tables")
  @@schema("shared")
}

model CatalogColumn {
  id           Int          @id @default(autoincrement())
  tableId      Int          @map("table_id")
  name         String       @db.VarChar(255)
  dataType     String       @map("data_type") @db.VarChar(100)
  nullable     Boolean      @default(true)
  isPrimaryKey Boolean      @default(false) @map("is_primary_key")
  isForeignKey Boolean      @default(false) @map("is_foreign_key")
  description  String       @default("")
  validValues  String       @default("") @map("valid_values")
  codingNotes  String       @default("") @map("coding_notes")
  isPhi        Boolean      @default(false) @map("is_phi")
  notes        String       @default("")
  table        CatalogTable @relation(fields: [tableId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tableId, name], map: "uq_shared_column_table_name")
  @@map("catalog_columns")
  @@schema("shared")
}

model TableRelationship {
  id               Int          @id @default(autoincrement())
  fromTableId      Int          @map("from_table_id")
  toTableId        Int          @map("to_table_id")
  fromColumn       String       @map("from_column") @db.VarChar(255)
  toColumn         String       @map("to_column") @db.VarChar(255)
  relationshipType String       @default("many_to_one") @map("relationship_type") @db.VarChar(50)
  description      String       @default("")
  fromTable        CatalogTable @relation("FromTable", fields: [fromTableId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toTable          CatalogTable @relation("ToTable", fields: [toTableId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("table_relationships")
  @@schema("shared")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  action       String   @db.VarChar(100)
  resourceType String   @default("") @map("resource_type") @db.VarChar(100)
  resourceId   String   @default("") @map("resource_id") @db.VarChar(100)
  details      String   @default("")
  ipAddress    String   @default("") @map("ip_address") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_logs")
  @@schema("shared")
}

model ProjectStatusHistory {
  id                    Int                  @id @default(autoincrement())
  status                project_status
  notes                 String?
  actorUserId           Int?                 @map("actor_user_id")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  projectVersionId      Int                  @map("project_version_id")
  committeeEvaluationId Int?                 @map("committee_evaluation_id")
  projectVersion        ProjectVersion       @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_shared_project_status_history_project_version")
  committeeEvaluation   CommitteeEvaluation? @relation(fields: [committeeEvaluationId], references: [id], onUpdate: NoAction, map: "fk_shared_status_history_committee_evaluation")
  actorUser             User?                @relation("StatusActor", fields: [actorUserId], references: [id], onUpdate: NoAction)

  @@index([actorUserId], map: "idx_shared_project_status_history_actor_user_id")
  @@index([projectVersionId], map: "idx_shared_project_status_history_project_version_id")
  @@index([committeeEvaluationId], map: "idx_shared_status_history_committee_evaluation_id")
  @@map("project_status_history")
  @@schema("shared")
}

model WizardSession {
  id               Int               @id @default(autoincrement())
  userId           Int               @map("user_id")
  wizardType       wizard_type       @map("wizard_type")
  currentStep      String            @map("current_step") @db.VarChar(50)
  title            String            @default("Untitled") @db.VarChar(255)
  datasetId        Int?              @map("dataset_id")
  linkedProjectId  Int?              @map("linked_project_id")
  sectionData      String            @default("{}") @map("section_data")
  scriptContent    String            @default("") @map("script_content")
  validationResult String            @default("{}") @map("validation_result")
  qualityChecklist String            @default("{}") @map("quality_checklist")
  llmModelUsed     String            @default("") @map("llm_model_used") @db.VarChar(100)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  projectVersions  ProjectVersion[]
  messages         ChatMessage[]
  cleaningVersions CleaningVersion[]
  exports          ExportArtifact[]
  dataset          Dataset?          @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedProject    WizardSession?    @relation("LinkedWizardSession", fields: [linkedProjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedSessions   WizardSession[]   @relation("LinkedWizardSession")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("wizard_sessions")
  @@schema("assistant")
}

model ChatMessage {
  id         Int           @id @default(autoincrement())
  sessionId  Int           @map("session_id")
  role       String        @db.VarChar(20)
  content    String
  channel    String        @default("intake") @db.VarChar(20)
  sectionKey String?       @map("section_key") @db.VarChar(50)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  session    WizardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("chat_messages")
  @@schema("assistant")
}

model ExportArtifact {
  id           Int               @id @default(autoincrement())
  sessionId    Int               @map("session_id")
  filename     String            @db.VarChar(255)
  filePath     String            @map("file_path") @db.VarChar(500)
  artifactType String            @map("artifact_type") @db.VarChar(50)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  documents    ProjectDocument[]
  session      WizardSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("export_artifacts")
  @@schema("assistant")
}

model CleaningVersion {
  id               Int           @id @default(autoincrement())
  sessionId        Int           @map("session_id")
  versionNumber    Int           @map("version_number")
  label            String        @default("") @db.VarChar(255)
  scriptContent    String        @default("") @map("script_content")
  validationResult String        @default("{}") @map("validation_result")
  messagesSnapshot String        @default("[]") @map("messages_snapshot")
  notes            String        @default("")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  session          WizardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, versionNumber], map: "uq_assistant_cleaning_version")
  @@map("cleaning_versions")
  @@schema("assistant")
}

model Project {
  id          Int              @id @default(autoincrement())
  ownerUserId Int              @map("owner_user_id")
  title       String           @db.VarChar(255)
  submittedAt DateTime?        @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  versions    ProjectVersion[]
  owner       User             @relation("ProjectOwner", fields: [ownerUserId], references: [id], onUpdate: NoAction)

  @@index([ownerUserId], map: "idx_admin_projects_owner_user_id")
  @@map("projects")
  @@schema("admin")
}

model ProjectDocument {
  id                     Int             @id @default(autoincrement())
  sourceExportArtifactId Int?            @map("source_export_artifact_id")
  documentType           String          @map("document_type") @db.VarChar(100)
  originalFilename       String          @map("original_filename") @db.VarChar(255)
  storagePath            String          @map("storage_path")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  projectVersionId       Int             @map("project_version_id")
  projectVersion         ProjectVersion  @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_project_documents_project_version")
  sourceExportArtifact   ExportArtifact? @relation(fields: [sourceExportArtifactId], references: [id], onUpdate: NoAction)

  @@index([projectVersionId], map: "idx_admin_project_documents_project_version_id")
  @@index([sourceExportArtifactId], map: "idx_admin_project_documents_source_export_artifact_id")
  @@map("project_documents")
  @@schema("admin")
}

model ProjectVersion {
  id                       Int                    @id @default(autoincrement())
  projectId                Int                    @map("project_id")
  versionNumber            Int                    @map("version_number")
  sourceWizardSessionId    Int                    @map("source_wizard_session_id")
  userCoepDataId           Int                    @map("user_coep_data_id")
  characterizationSnapshot Json                   @default("{}") @map("characterization_snapshot")
  status                   project_status
  submittedAt              DateTime?              @map("submitted_at") @db.Timestamptz(6)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  committeeEvaluation      CommitteeEvaluation?
  documents                ProjectDocument[]
  userCoepData             UserCoepData           @relation(fields: [userCoepDataId], references: [id], onUpdate: NoAction, map: "fk_admin_project_versions_user_coep")
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceWizardSession      WizardSession          @relation(fields: [sourceWizardSessionId], references: [id], onUpdate: NoAction)
  statusHistory            ProjectStatusHistory[]

  @@unique([projectId, versionNumber], map: "uq_admin_project_versions_project_number")
  @@index([projectId], map: "idx_admin_project_versions_project_id")
  @@index([sourceWizardSessionId], map: "idx_admin_project_versions_source_wizard_session_id")
  @@index([userCoepDataId], map: "idx_admin_project_versions_user_coep_data_id")
  @@map("project_versions")
  @@schema("admin")
}

model Specialty {
  id               Int                      @id @default(autoincrement())
  code             String                   @unique @db.VarChar(100)
  name             String                   @unique(map: "uq_admin_specialties_name") @db.VarChar(255)
  nameNormalized   String                   @unique @map("name_normalized") @db.VarChar(255)
  description      String                   @default("")
  guidanceContext  String                   @default("") @map("guidance_context")
  isActive         Boolean                  @default(true) @map("is_active")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  committeeMembers CommitteeMemberProfile[]

  @@index([isActive], map: "idx_admin_specialties_is_active")
  @@map("specialties")
  @@schema("admin")
}

model ResearcherProfile {
  userId       Int      @id @map("user_id")
  researchArea String?  @map("research_area") @db.VarChar(255)
  position     String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("researcher_profiles")
  @@schema("admin")
}

model CommitteeMemberProfile {
  userId      Int                   @id @map("user_id")
  specialtyId Int                   @map("specialty_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  evaluations CommitteeEvaluation[] @relation("ResponsibleMember")
  specialty   Specialty             @relation(fields: [specialtyId], references: [id], onUpdate: NoAction)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("committee_member_profiles")
  @@schema("admin")
}

model UserCoepData {
  id                  Int                  @id @default(autoincrement())
  userId              Int                  @map("user_id")
  caae                String               @db.VarChar(50)
  opinionNumber       String               @map("opinion_number") @db.VarChar(50)
  approvalDate        DateTime             @map("approval_date") @db.Date
  documentFilename    String               @map("document_filename") @db.VarChar(255)
  documentStoragePath String               @map("document_storage_path")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  projectVersions     ProjectVersion[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authEvaluations     UserAuthEvaluation[]

  @@unique([userId, caae], map: "uq_admin_user_coep_data_user_caae")
  @@map("user_coep_data")
  @@schema("admin")
}

model CommitteeEvaluation {
  id                      Int                         @id @default(autoincrement())
  projectVersionId        Int                         @unique @map("project_version_id")
  responsibleMemberUserId Int                         @map("responsible_member_user_id")
  result                  committee_evaluation_result
  justification           String
  evaluatedAt             DateTime?                   @map("evaluated_at") @db.Timestamptz(6)
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  projectVersion          ProjectVersion              @relation(fields: [projectVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responsibleMember       CommitteeMemberProfile      @relation("ResponsibleMember", fields: [responsibleMemberUserId], references: [userId], onUpdate: NoAction)
  statusHistory           ProjectStatusHistory[]

  @@map("committee_evaluations")
  @@schema("admin")
}

enum wizard_type {
  project_doc
  data_clean

  @@schema("assistant")
}

enum user_role {
  researcher
  admin
  committee

  @@schema("shared")
}

enum user_account_status {
  pending
  active
  rejected
  disabled

  @@schema("shared")
}

enum committee_evaluation_result {
  approved
  needs_changes
  rejected

  @@schema("admin")
}

enum project_status {
  submitted_to_committee
  resubmitted_to_committee
  under_review
  needs_changes
  approved
  rejected

  @@schema("shared")
}

enum userrole {
  researcher
  admin

  @@schema("assistant")
}

enum wizardtype {
  project_doc
  data_clean

  @@schema("assistant")
}
