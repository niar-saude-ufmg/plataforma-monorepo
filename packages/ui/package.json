{
  "name": "@niar/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/Button": {
      "types": "./dist/components/Button/Button.d.ts",
      "import": "./dist/components/Button/Button.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./dist/tokens/styles/tokens.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens:generate": "style-dictionary build --config style-dictionary.config.json && node scripts/copy-token-css.mjs",
    "build": "pnpm clean && pnpm tokens:generate && tsc -p tsconfig.build.json",
    "check": "pnpm tokens:generate && node scripts/check-tokens.mjs && tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "pnpm tokens:generate && concurrently -k -n tokens,types \"pnpm tokens:watch\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\"",
    "tokens:watch": "chokidar \"src/tokens/*.json\" \"style-dictionary.config.json\" -c \"pnpm tokens:generate\"",
    "storybook": "pnpm tokens:generate && concurrently -k -n tokens,storybook \"pnpm tokens:watch\" \"storybook dev -p 6006 --no-open\"",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:build": "pnpm tokens:generate && storybook build --disable-telemetry",
    "test": "pnpm tokens:generate && vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^9.4.0",
    "@mui/utils": "^9.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.5"
  },
  "files": [
    "dist"
  ]
}
